FROM jenkins/jenkins:lts-jdk17

USER root

# Установка системных зависимостей, QEMU, Python3 и инструментов тестирования
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    python3-pip \
    python3-venv \
    qemu-system-arm \
    ipmitool \
    curl \
    git \
    wget \
    chromium \
    chromium-driver \
    && rm -rf /var/lib/apt/lists/*

# Настройка переменных окружения для headless Chrome и QEMU
ENV CHROME_BIN=/usr/bin/chromium
ENV CHROMEDRIVER_PATH=/usr/bin/chromedriver

USER jenkins
